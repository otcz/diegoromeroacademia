# Formato uniforme entre editores. Refuerza docs/01-estandares-codigo.md.
# UTF-8 es obligatorio: los comentarios y la documentación llevan tildes y eñes,
# aunque los identificadores nunca las lleven (ADR 0002).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.java]
indent_size = 4

[*.{xml,yml,yaml}]
indent_size = 2

# Comillas simples: es lo que genera y espera el ecosistema de Angular, y lo que aplica
# Prettier en este proyecto. Regla heredada del .editorconfig que el CLI creo dentro de
# frontend/ y que se fusiono aqui: aquel declaraba `root = true`, lo que CORTABA la
# herencia de este archivo y dejaba al frontend sin las reglas del proyecto.
[*.ts]
quote_type = single

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
