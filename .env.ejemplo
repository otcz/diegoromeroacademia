# Plantilla de variables de entorno. Copiar como .env y rellenar.
#
#   cp .env.ejemplo .env
#
# .env esta ignorado por Git y NUNCA debe versionarse (docs/03 §5).
# En produccion estos valores llegan desde Google Secret Manager, no desde un archivo.

# ---------- Base de datos ----------
# En local, docker-compose.yml ya provee estos valores mediante el perfil "local".
BD_URL=jdbc:postgresql://localhost:5432/academia
BD_USUARIO=academia
BD_CONTRASENA=
BD_POOL_MAXIMO=20

# ---------- Aplicacion ----------
PUERTO=8080
SPRING_PROFILES_ACTIVE=local
ORIGENES_PERMITIDOS=http://localhost:4200

# ---------- Autenticacion ----------
JWT_SECRETO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------- Video (decision pendiente #3) ----------
VIDEO_PROVEEDOR=
VIDEO_API_KEY=
VIDEO_DOMINIOS_AUTORIZADOS=http://localhost:4200

# ---------- Pasarela de pago (decision pendiente #1) ----------
COMERCIO_PASARELA=
PASARELA_LLAVE_PUBLICA=
PASARELA_LLAVE_PRIVADA=
PASARELA_SECRETO_WEBHOOK=

# ---------- Almacenamiento y correo ----------
GCS_BUCKET=
SENDGRID_API_KEY=

# ---------- WhatsApp ----------
WHATSAPP_NUMERO=
WHATSAPP_TOKEN=
