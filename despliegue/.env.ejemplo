# Variables del entorno de demostracion. Copiar como despliegue/.env en el servidor
# y rellenar. El archivo .env esta ignorado por Git y no debe versionarse.
#
#   cp despliegue/.env.ejemplo despliegue/.env && chmod 600 despliegue/.env

# Base de datos de la demostracion. Generar una contrasena nueva, no reutilizar
# ninguna de otro proyecto de la misma maquina:
#   openssl rand -base64 32
BD_NOMBRE=academia
BD_USUARIO=academia
BD_CONTRASENA=

# URL publica del tunel. Se usa como lista blanca de CORS del backend.
URL_PUBLICA=https://demo.diegoromeroacademia.com
